.components.parameters.Checksum."x-go-name" = "ChecksumParameter" |
.components.schemas.Error.description = "A stable Syfon API error that remains compatible with the GA4GH DRS error shape." |
.components.schemas.Error.required = ["code", "status", "message"] |
.components.schemas.Error.properties.code = {
  "type": "string",
  "description": "Stable machine-readable error code.",
  "enum": [
    "not_found",
    "unauthorized",
    "forbidden",
    "conflict",
    "invalid_input",
    "rate_limited",
    "unavailable",
    "internal_error",
    "request_failed"
  ]
} |
.components.schemas.Error.properties.status = {
  "type": "integer",
  "description": "HTTP response status."
} |
.components.schemas.Error.properties.message = {
  "type": "string",
  "description": "Human-readable error message."
} |
.components.schemas.Error.properties.request_id = {
  "type": "string",
  "description": "Request identifier for support and log correlation."
} |
.components.schemas.Error.properties.msg.deprecated = true |
.components.schemas.Error.properties.msg.description = "GA4GH-compatible alias for message." |
.components.schemas.Error.properties.status_code.deprecated = true |
.components.schemas.Error.properties.status_code.description = "Legacy alias for status."
